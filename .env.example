# Keep the real token in Replit Secrets or a local .env file; never commit it.
BOT_TOKEN=

# Optional first administrators (comma-separated Telegram numeric user IDs).
# The shell bootstrap command is also available: uv run python -m automotive_bot.bootstrap_admin <TELEGRAM_ID>
ADMIN_IDS=

# SQLite is persistent for a single running project. Set DATABASE_URL to a hosted PostgreSQL URL for multi-instance production.
DATABASE_URL=sqlite+aiosqlite:///./data/automotive.db
CURRENCY=EUR
